<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0a0a0a">
<title>OmegaStream</title>
<style>
:root{--bg:#0a0a0a;--card:#161616;--card2:#222;--text:#fff;--dim:#999;--accent:#e50914;--accent2:#f6121d;--r:10px}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;min-height:100vh;overflow-x:hidden}
.header{position:fixed;top:0;left:0;right:0;z-index:100;background:linear-gradient(to bottom,var(--bg),rgba(10,10,10,.95),transparent);padding:12px 16px;display:flex;align-items:center;gap:12px}
.logo{font-size:22px;font-weight:900;color:var(--accent);letter-spacing:-.5px;white-space:nowrap}
.search-wrap{flex:1;max-width:380px}
.search-wrap input{width:100%;padding:9px 16px;border-radius:20px;border:1px solid #333;background:var(--card);color:var(--text);font-size:14px;outline:none;transition:border .2s}
.search-wrap input:focus{border-color:var(--accent)}
.tabs{display:flex;overflow-x:auto;gap:6px;padding:62px 16px 12px;scrollbar-width:none;-ms-overflow-style:none}
.tabs::-webkit-scrollbar{display:none}
.tab{padding:7px 16px;border-radius:20px;background:var(--card);color:var(--dim);border:none;font-size:12.5px;cursor:pointer;white-space:nowrap;transition:all .2s;font-weight:500}
.tab.active{background:var(--accent);color:#fff}
.tab:hover:not(.active){background:var(--card2);color:#fff}
.content{padding:8px 12px 30px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px}
@media(min-width:600px){.grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px}}
@media(min-width:900px){.grid{grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:18px}}
.card{cursor:pointer;transition:transform .2s,box-shadow .2s;border-radius:var(--r);overflow:hidden;background:var(--card)}
.card:hover{transform:translateY(-4px);box-shadow:0 8px 25px rgba(0,0,0,.4)}
.card img{width:100%;aspect-ratio:2/3;object-fit:cover;display:block;background:#1a1a1a}
.card-info{padding:8px 10px}
.card-title{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-sub{font-size:11px;color:var(--dim);margin-top:2px;display:flex;gap:6px;align-items:center}
.vj-badge{display:inline-block;padding:1px 7px;background:var(--accent);border-radius:8px;font-size:9.5px;font-weight:700;color:#fff}
.loading{text-align:center;padding:50px 20px;color:var(--dim)}
.spinner{width:36px;height:36px;border:3px solid #333;border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
@keyframes spin{to{transform:rotate(360deg)}}
.empty{text-align:center;padding:50px 20px;color:var(--dim);font-size:15px}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.97);z-index:200;overflow-y:auto;overscroll-behavior:contain}
.overlay.show{display:block}
.d-hero{position:relative;height:38vh;min-height:220px;overflow:hidden}
.d-hero img{width:100%;height:100%;object-fit:cover;opacity:.35}
.d-hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:60%;background:linear-gradient(transparent,rgba(0,0,0,.97))}
.d-close{position:absolute;top:12px;right:12px;background:rgba(0,0,0,.6);border:none;color:#fff;font-size:22px;width:38px;height:38px;border-radius:50%;cursor:pointer;z-index:10}
.d-body{position:relative;margin-top:-70px;padding:0 16px 30px;z-index:5}
.d-row{display:flex;gap:16px;align-items:flex-start}
.d-poster{width:110px;border-radius:var(--r);box-shadow:0 6px 25px rgba(0,0,0,.6);flex-shrink:0}
@media(min-width:600px){.d-poster{width:160px}.d-body{padding:0 30px 30px}}
.d-title{font-size:22px;font-weight:800;line-height:1.2}
.d-meta{font-size:13px;color:var(--dim);margin:8px 0;display:flex;gap:10px;flex-wrap:wrap}
.d-genre{display:inline-block;padding:3px 10px;background:var(--card2);border-radius:12px;font-size:11px;margin:2px}
.d-desc{font-size:13.5px;line-height:1.65;color:#bbb;margin:14px 0;max-width:750px}
.btn-play{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;transition:background .2s;margin-top:8px}
.btn-play:hover{background:var(--accent2)}
.eps{margin-top:22px;max-width:850px}
.eps h3{font-size:17px;margin-bottom:12px}
.ep-list{display:flex;flex-direction:column;gap:8px}
.ep{display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--card);border-radius:var(--r);cursor:pointer;transition:background .2s}
.ep:hover{background:var(--card2)}
.ep-num{font-size:16px;font-weight:800;color:var(--accent);min-width:30px}
.ep-name{flex:1;font-size:13.5px;font-weight:500}
.ep-date{font-size:11px;color:var(--dim)}
.ep-btn{background:var(--accent);color:#fff;border:none;padding:5px 14px;border-radius:14px;font-size:11px;font-weight:600;cursor:pointer}
.player{display:none;position:fixed;inset:0;background:#000;z-index:300;flex-direction:column}
.player.show{display:flex}
.player video{flex:1;width:100%;background:#000;outline:none}
.p-close{position:absolute;top:8px;right:8px;background:rgba(255,255,255,.15);border:none;color:#fff;font-size:18px;width:34px;height:34px;border-radius:50%;cursor:pointer;z-index:10}
.p-nav{display:flex;gap:6px;padding:10px 12px;overflow-x:auto;background:#111;scrollbar-width:none}
.p-nav::-webkit-scrollbar{display:none}
.p-nav button{padding:7px 15px;background:var(--card2);color:#fff;border:none;border-radius:14px;font-size:12px;cursor:pointer;white-space:nowrap;flex-shrink:0;transition:background .2s}
.p-nav button.active{background:var(--accent)}
.p-nav button:hover{background:var(--accent2)}
.p-status{color:var(--dim);padding:8px 12px;font-size:12px}
</style>
</head>
<body>

<div class="header">
    <div class="logo">OMEGASTREAM</div>
    <div class="search-wrap">
        <input type="text" id="searchInput" placeholder="Search movies &amp; series..." autocomplete="off">
    </div>
</div>

<div class="tabs" id="tabs"></div>
<div class="content" id="content"><div class="loading"><div class="spinner"></div>Loading...</div></div>

<div class="overlay" id="detailOverlay">
    <div class="d-hero">
        <img id="dBg" src="" alt="">
        <button class="d-close" onclick="closeDetail()">&times;</button>
    </div>
    <div class="d-body">
        <div class="d-row">
            <img class="d-poster" id="dPoster" src="" alt="">
            <div>
                <h1 class="d-title" id="dTitle"></h1>
                <div class="d-meta" id="dMeta"></div>
                <div id="dGenres"></div>
            </div>
        </div>
        <p class="d-desc" id="dDesc"></p>
        <button class="btn-play" id="dPlay" onclick="playContent()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            PLAY NOW
        </button>
        <div class="eps" id="epsSection" style="display:none">
            <h3>Episodes</h3>
            <div class="ep-list" id="epList"></div>
        </div>
    </div>
</div>

<div class="player" id="playerOverlay">
    <button class="p-close" onclick="closePlayer()">&times;</button>
    <video id="videoPlayer" controls autoplay playsinline></video>
    <div class="p-nav" id="pNav"></div>
</div>

<script>
const API_BASE = "https://s-u.in";
const PROXIES = [
    function(u){return "https://api.allorigins.win/get?url=" + encodeURIComponent(u)},
    function(u){return "https://api.codetabs.com/v1/proxy?quest=" + encodeURIComponent(u)},
    function(u){return "https://corsproxy.io/?" + encodeURIComponent(u)}
];

async function fetchTimeout(url, ms) {
    ms = ms || 12000;
    var ctrl = new AbortController();
    var t = setTimeout(function(){ctrl.abort()}, ms);
    try {
        var r = await fetch(url, {signal: ctrl.signal});
        clearTimeout(t);
        return r;
    } catch(e) {
        clearTimeout(t);
        throw e;
    }
}

async function apiFetch(path) {
    var target = API_BASE + path;
    for (var i = 0; i < PROXIES.length; i++) {
        try {
            var res = await fetchTimeout(PROXIES[i](target));
            if (!res.ok) continue;
            var text = await res.text();
            var data;
            try { data = JSON.parse(text); } catch(e) { continue; }
            if (data && typeof data.contents === "string") {
                try { return JSON.parse(data.contents); } catch(e) { continue; }
            }
            return data;
        } catch(e) { continue; }
    }
    throw new Error("All proxies failed. Check connection and try again.");
}

var CATS = [
    {id:"moviebay-latest-movies",type:"movie",name:"Latest Movies"},
    {id:"moviebay-latest-series",type:"series",name:"Latest Series"},
    {id:"moviebay-trending-movies",type:"movie",name:"Trending Movies"},
    {id:"moviebay-trending-series",type:"series",name:"Trending Series"},
    {id:"moviebay-popular-movies",type:"movie",name:"Popular Movies"},
    {id:"moviebay-popular-series",type:"series",name:"Popular Series"},
    {id:"moviebay-year-movies",type:"movie",name:"2025-2026 Movies"},
    {id:"moviebay-year-series",type:"series",name:"2025-2026 Series"},
    {id:"moviebay-vj-movies",type:"movie",name:"Top VJ Movies"},
    {id:"moviebay-vj-series",type:"series",name:"Top VJ Series"},
    {id:"moviebay-all-movies",type:"movie",name:"All Movies"},
    {id:"moviebay-all-series",type:"series",name:"All Series"}
];

var activeCat = 0;
var currentDetail = null;
var currentEps = [];
var currentEpIdx = 0;

function renderTabs() {
    var html = "";
    for (var i = 0; i < CATS.length; i++) {
        html += '<button class="tab' + (i === activeCat ? " active" : "") + '" onclick="selectCat(' + i + ')">' + CATS[i].name + '</button>';
    }
    document.getElementById("tabs").innerHTML = html;
}

async function selectCat(i) {
    activeCat = i;
    var tabs = document.querySelectorAll(".tab");
    for (var j = 0; j < tabs.length; j++) tabs[j].classList.toggle("active", j === i);
    await loadCatalog();
}

async function loadCatalog(search) {
    var el = document.getElementById("content");
    el.innerHTML = '<div class="loading"><div class="spinner"></div>Loading...</div>';
    try {
        var cat = CATS[activeCat];
        var path = "/catalog/" + cat.type + "/" + cat.id + ".json";
        if (search) path = "/catalog/" + cat.type + "/" + cat.id + "/search=" + encodeURIComponent(search) + ".json";
        var data = await apiFetch(path);
        var metas = data.metas || [];
        if (!metas.length) { el.innerHTML = '<div class="empty">No content found</div>'; return; }
        var html = "";
        if (search) html += '<div style="padding:4px 6px 12px;font-size:16px;font-weight:700">Results for "' + search + '"</div>';
        html += '<div class="grid">';
        for (var i = 0; i < metas.length; i++) {
            var m = metas[i];
            html += '<div class="card" onclick="openDetail(\'' + m.type + '\',\'' + m.id + '\')">'
                + '<img src="' + (m.poster || "") + '" alt="" loading="lazy">'
                + '<div class="card-info">'
                + '<div class="card-title">' + m.name + '</div>'
                + '<div class="card-sub"><span>' + (m.releaseInfo || "") + '</span>'
                + (m.vj ? '<span class="vj-badge">' + m.vj + '</span>' : "")
                + '</div></div></div>';
        }
        html += '</div>';
        el.innerHTML = html;
    } catch(e) {
        el.innerHTML = '<div class="empty">' + e.message + '</div>';
    }
}

async function openDetail(type, id) {
    var ov = document.getElementById("detailOverlay");
    ov.classList.add("show");
    document.body.style.overflow = "hidden";
    try {
        var data = await apiFetch("/meta/" + type + "/" + id + ".json");
        var m = data.meta || data;
        currentDetail = m;
        document.getElementById("dBg").src = m.background || m.poster || "";
        document.getElementById("dPoster").src = m.poster || "";
        document.getElementById("dTitle").textContent = m.name || "";
        document.getElementById("dMeta").innerHTML =
            "<span>" + (m.releaseInfo || "") + "</span>" +
            (m.vj ? '<span style="color:#e50914">' + m.vj + "</span>" : "");
        var genres = m.genres || [];
        var gHtml = "";
        for (var i = 0; i < genres.length; i++) gHtml += '<span class="d-genre">' + genres[i] + "</span>";
        document.getElementById("dGenres").innerHTML = gHtml;
        document.getElementById("dDesc").textContent = m.description || "No description.";
        var vids = m.videos || [];
        if (type === "series" && vids.length) {
            currentEps = vids;
            document.getElementById("epsSection").style.display = "block";
            var epHtml = "";
            for (var i = 0; i < vids.length; i++) {
                var ep = vids[i];
                var num = ep.number || ep.episode || (i + 1);
                epHtml += '<div class="ep" onclick="playEpisode(' + i + ')">'
                    + '<div class="ep-num">E' + String(num).padStart(2, "0") + '</div>'
                    + '<div class="ep-name">' + (ep.name || "Episode " + (i + 1)) + '</div>'
                    + '<div class="ep-date">' + (ep.released || "").split("T")[0] + '</div>'
                    + '<button class="ep-btn">PLAY</button></div>';
            }
            document.getElementById("epList").innerHTML = epHtml;
        } else {
            currentEps = [];
            document.getElementById("epsSection").style.display = "none";
        }
    } catch(e) {
        document.getElementById("dDesc").textContent = "Failed to load: " + e.message;
    }
}

function closeDetail() {
    document.getElementById("detailOverlay").classList.remove("show");
    document.body.style.overflow = "";
}

async function playContent() {
    if (!currentDetail) return;
    if (currentDetail.type === "series" && currentEps.length) { playEpisode(0); return; }
    var vid = document.getElementById("videoPlayer");
    var nav = document.getElementById("pNav");
    document.getElementById("playerOverlay").classList.add("show");
    nav.innerHTML = '<div class="p-status">Loading stream...</div>';
    vid.onerror = function(){ nav.innerHTML = '<div class="p-status" style="color:#f44">Video failed to load</div>'; };
    try {
        var data = await apiFetch("/stream/movie/" + currentDetail.id + ".json");
        var s = (data.streams || [])[0];
        if (s && s.url) {
            vid.src = s.url;
            vid.play();
            nav.innerHTML = '<div class="p-status">' + (s.name || "Movie") + '</div>';
        } else {
            nav.innerHTML = '<div class="p-status" style="color:#f44">No stream available</div>';
        }
    } catch(e) {
        nav.innerHTML = '<div class="p-status" style="color:#f44">' + e.message + '</div>';
    }
}

async function playEpisode(i) {
    if (!currentDetail || !currentEps[i]) return;
    currentEpIdx = i;
    var ep = currentEps[i];
    var season = ep.season || 1;
    var num = ep.number || ep.episode || (i + 1);
    var vid = document.getElementById("videoPlayer");
    var nav = document.getElementById("pNav");
    document.getElementById("playerOverlay").classList.add("show");
    nav.innerHTML = '<div class="p-status">Loading stream...</div>';
    vid.onerror = function(){ nav.innerHTML = '<div class="p-status" style="color:#f44">Video failed to load</div>'; };
    try {
        var data = await apiFetch("/stream/series/" + currentDetail.id + ":" + season + ":" + num + ".json");
        var s = (data.streams || [])[0];
        if (s && s.url) {
            vid.src = s.url;
            vid.play();
            var navHtml = "";
            for (var j = 0; j < currentEps.length; j++) {
                var e = currentEps[j];
                var eNum = e.number || e.episode || (j + 1);
                navHtml += '<button class="' + (j === i ? "active" : "") + '" onclick="playEpisode(' + j + ')">E' + String(eNum).padStart(2, "0") + '</button>';
            }
            nav.innerHTML = navHtml;
            vid.onended = function(){ if (i < currentEps.length - 1) playEpisode(i + 1); };
        } else {
            nav.innerHTML = '<div class="p-status" style="color:#f44">No stream available</div>';
        }
    } catch(e) {
        nav.innerHTML = '<div class="p-status" style="color:#f44">' + e.message + '</div>';
    }
}

function closePlayer() {
    var vid = document.getElementById("videoPlayer");
    vid.pause();
    vid.src = "";
    document.getElementById("playerOverlay").classList.remove("show");
}

var searchTimer;
document.getElementById("searchInput").addEventListener("input", function(e) {
    clearTimeout(searchTimer);
    var q = e.target.value.trim();
    searchTimer = setTimeout(function() {
        if (q.length >= 2) loadCatalog(q);
        else if (!q) loadCatalog();
    }, 500);
});

document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
        if (document.getElementById("playerOverlay").classList.contains("show")) closePlayer();
        else if (document.getElementById("detailOverlay").classList.contains("show")) closeDetail();
    }
});

renderTabs();
loadCatalog();
</script>
</body>
</html>
